{
  "name": "concert-booking-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "High-throughput virtual queue concert ticket booking backend",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && mkdir -p dist/db && cp src/db/schema.sql dist/db/",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "tsx tests/correctness.test.ts",
    "seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.14",
    "@fastify/cors": "^9.0.1",
    "@fastify/websocket": "^8.3.1",
    "dotenv": "^16.4.5",
    "fastify": "^4.26.2",
    "pg": "^8.11.5"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/pg": "^8.11.4",
    "@types/ws": "^8.18.2",
    "tsx": "^4.7.1",
    "typescript": "^5.4.3"
  }
}
